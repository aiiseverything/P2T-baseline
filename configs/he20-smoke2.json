{
  "_comment": "Two-rollout smoke for the he20 arm. Everything scientific is identical to he20250.json -- same actor, same SFT adapter, same shared sigma0, same mask settings, same device plan -- so the smoke exercises the real code path rather than a reduced one. Only the run identity, the rollout count and autopush differ: push_every is 0 because a two-step run has nothing worth publishing, and the run writes to its own dirs so it can never mix into the formal run's metrics.jsonl. Run with: bash he20/scripts/start_he20.sh he20-smoke2  (or HE20_GPUS=0,1,2,3 for the device-plan check).",
  "run_name": "he20-smoke2",
  "model_name": "models/Qwen3-14B-Base",
  "reward_model_name": "models/Skywork-Reward-V2-Qwen3-8B",
  "init_adapter": "models/sft-p2t",
  "output_dir": "runs/he20-smoke2",
  "report_dir": "reports/he20-smoke2",
  "actor_device": "cuda:0",
  "reward_device": "cuda:1",
  "vllm_gpus": [
    "2",
    "3"
  ],
  "vllm_tensor_parallel_size": 2,
  "vllm_gpu_memory_utilization": 0.85,
  "vllm_max_num_seqs": 32,
  "seed": 42,
  "generation_seed": 0,
  "group_size": 8,
  "prompts_per_rollout": 8,
  "rollout_iterations": 2,
  "optimizer_minibatch_responses": 64,
  "microbatch_responses": 1,
  "max_prompt_tokens": 2048,
  "max_response_tokens": 2048,
  "temperature": 1.0,
  "top_p": 1.0,
  "top_k": 0,
  "min_response_tokens": 0,
  "learning_rate": 5e-05,
  "weight_decay": 0.01,
  "max_grad_norm": 1.0,
  "clip_eps": 0.2,
  "beta": 0.03,
  "lora": true,
  "lora_r": 64,
  "lora_alpha": 128,
  "lora_dropout": 0.0,
  "target_modules": [
    "q_proj",
    "k_proj",
    "v_proj",
    "o_proj",
    "gate_proj",
    "up_proj",
    "down_proj"
  ],
  "gradient_checkpointing": true,
  "length_threshold_short": 8,
  "length_threshold_long": 1024,
  "short_penalty_strength": 0.5,
  "long_penalty_strength": 2.0,
  "advantage_std_floor_fraction": 0.5,
  "sigma0": 3.0323000897825447,
  "calibration_prompts": 128,
  "degenerate_newline_run": 32,
  "degenerate_penalty": 1.0,
  "checkpoint_interval": 1,
  "keep_checkpoints": 2,
  "token_chunk_size": 128,
  "validation_size": 2000,
  "push_every": 0,
  "push_remote": "p2t-origin",
  "push_branch": "main",
  "push_local_branch": "p2t-baseline",
  "keep_adapters": 2,
  "policy_head_dtype": "float32",
  "entropy_top_ratio": 0.2,
  "entropy_top_rule": "threshold"
}
