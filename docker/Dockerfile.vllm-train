FROM registry.h.pjlab.org.cn/ailab/vllm-openai-cu129-nightly-x86_64:latest

# The vLLM image already supplies torch, vLLM, Transformers, Accelerate,
# datasets, Jinja2, Pillow, safetensors and sentencepiece.  Add only the
# packages needed by this project's LoRA trainer and local parquet reader.
RUN python3 -m pip install --no-cache-dir \
    --index-url http://mirrors.i.h.pjlab.org.cn/repository/pypi-proxy/simple/ \
    --trusted-host mirrors.i.h.pjlab.org.cn \
    "peft==0.20.0" \
    "pyarrow>=15,<22"

ENV PYTHONUNBUFFERED=1
WORKDIR /workspace/VPO-RM
